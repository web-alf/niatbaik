# ============================================================
#  NIATBAIK.ORG — Go+Bun Production Environment
# ============================================================

APP_PORT=8080
APP_ENV=production

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USER=niatbaik
DB_PASSWORD=password
DB_NAME=niatbaik

# PostgreSQL container needs this exact var name
POSTGRES_PASSWORD=password

# JWT
JWT_SECRET=GANTI_DENGAN_RANDOM_openssl_rand_-hex_32
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# Upload
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760

# CORS
CORS_ORIGINS=https://donasi.niatbaik.org

# Mail (sama dengan Laravel config)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=email@niatbaik.com
MAIL_PASSWORD=GANTI_APP_PASSWORD
MAIL_FROM=noreply@niatbaik.com

# Moota & Flip credentials dikelola lewat dashboard admin
# Tidak perlu di env — disimpan di database settings
