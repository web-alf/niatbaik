# ============================================================
#  NIATBAIK.ORG — Production Environment
#  Copy to .env.production and fill in real values
# ============================================================

# App
APP_PORT=8080
APP_ENV=production

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=niatbaik
DB_PASSWORD=GANTI_PASSWORD_KUAT_DISINI
DB_NAME=niatbaik

# JWT (WAJIB ganti di production!)
JWT_SECRET=GANTI_DENGAN_RANDOM_STRING_64_KARAKTER
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# Upload
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760

# CORS (domain production)
CORS_ORIGINS=https://donasi.niatbaik.org

# Moota (bank mutation — daftar gratis di moota.co)
MOOTA_API_KEY=
MOOTA_WEBHOOK_SECRET=

# Flip (payment gateway — daftar gratis di flip.id)
FLIP_SECRET_KEY=
FLIP_VALIDATION_TOKEN=
FLIP_BASE_URL=https://bigflip.id/api/v3
